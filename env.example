# 애플리케이션 기본 설정
APP_NAME=PDF Compressor(made by mesmerized!)
APP_VERSION=1.0.0
ENVIRONMENT=production

# 서버 설정
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=2
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# 업로드 설정
MAX_UPLOAD_SIZE_MB=512
MAX_FILES_PER_BATCH=20
UPLOAD_DIR=/data/uploads
RESULT_DIR=/data/results
TEMP_DIR=/data/temp

# Redis 설정
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery 워커 설정
WORKER_CONCURRENCY=1
TASK_TIMEOUT_SECONDS=900
TASK_MAX_RETRIES=3

# 파일 보관 설정
RETENTION_HOURS=24
CLEANUP_INTERVAL_HOURS=1

# 보안 설정
ENABLE_ANTIVIRUS=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# 로깅
LOG_LEVEL=WARNING
LOG_FORMAT=json

# PDF 압축 설정
ENABLE_ENGINE_FALLBACK=true

# 파일 해시 캐싱
ENABLE_DEDUPLICATION=true
