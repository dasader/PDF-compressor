# 설정 가능한 항목과 기본값 참조표.
#
# 이 파일을 .env로 복사할 필요는 없다. 실행 환경(docker compose)은 값을
# docker-compose.yml의 environment: 블록에서 직접 주입하며, 이미지 안에는
# .env가 들어가지 않는다. 값을 바꾸려면 docker-compose.yml을 고친다.
#
# 여기 적힌 키는 backend/app/core/config.py의 Settings와 1:1로 맞춰야 한다
# (어긋나면 tests/test_config.py가 잡는다).

# 애플리케이션 기본 설정
APP_NAME=PDF Compressor(made by mesmerized!)
APP_VERSION=1.0.0
ENVIRONMENT=production

# 서버 설정 (바인딩 주소·포트는 entrypoint.sh가 정한다)
WEB_CONCURRENCY=2
CORS_ORIGINS=http://localhost:8106

# 업로드 설정
MAX_UPLOAD_SIZE_MB=512
MAX_FILES_PER_BATCH=10
UPLOAD_DIR=/data/uploads
RESULT_DIR=/data/results
TEMP_DIR=/data/temp

# Redis 설정
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery 워커 설정
WORKER_CONCURRENCY=1
TASK_TIMEOUT_SECONDS=900
TASK_MAX_RETRIES=3
SYNC_COMPRESS_TIMEOUT_SECONDS=300

# 파일 보관 설정
RETENTION_HOURS=24
CLEANUP_INTERVAL_HOURS=1

# 보안 설정
ENABLE_ANTIVIRUS=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# 로깅
LOG_LEVEL=WARNING
LOG_FORMAT=json

# PDF 압축 설정
ENABLE_ENGINE_FALLBACK=true

# 파일 해시 캐싱
ENABLE_DEDUPLICATION=true
